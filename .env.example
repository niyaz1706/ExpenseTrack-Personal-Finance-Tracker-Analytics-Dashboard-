# ExpenseTrack Database Configuration
# Set your MySQL credentials here. Default is set to connect to localhost:3306
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/expensetrack_db

# Secret key for session security and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Flask Environment configuration: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1
